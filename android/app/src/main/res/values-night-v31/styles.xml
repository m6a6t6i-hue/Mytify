<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark start window matching the Winyl intro (#0C0D0F), no white flash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Android 12+ system splash: same background, no icon, so the Flutter
             Winyl intro is the only intro and starts on an identical screen. -->
        <item name="android:windowSplashScreenBackground">#0C0D0F</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_empty</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">#0C0D0F</item>
    </style>
</resources>
